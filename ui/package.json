{
  "name": "comeup-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:domain": "npm run build --prefix ../shared/domain",
    "build": "npm run build:domain && tsc -b && vite build",
    "typecheck": "npm run build:domain && tsc -b --noEmit",
    "preview": "serve -s dist -l ${PORT:-3000}",
    "start": "serve -s dist -l ${PORT:-3000}",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:sync:ios": "npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capgo/native-purchases": "^8.7.0",
    "@comeup/domain": "file:../shared/domain",
    "lucide-react": "^0.475.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^5.4.21"
  }
}
