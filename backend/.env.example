NODE_ENV=development
PORT=4000
HOST=0.0.0.0
BIND_HOST=0.0.0.0
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/comeup?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8081,http://localhost:3000
AI_SERVICE_URL=http://localhost:4100
AI_SERVICE_TOKEN=replace-with-shared-internal-token
ADMIN_EMAILS=admin@example.com
# Exercise media search in Admin → Media:
# 1. FitnessProgramer.com (animated GIFs, no key)
# 2. free-exercise-db (GitHub CDN photos, no key)
# 3. Optional WORKOUTX_API_KEY for animations — must start with wx_
# Meme sources (Giphy/Tenor) are off unless explicitly enabled — not recommended.
GIF_SEARCH_ENABLE_MEME_SOURCES=false
WORKOUTX_API_KEY=
TENOR_API_KEY=
GIPHY_API_KEY=
# Password reset (optional in dev — reset link is logged to the server console)
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Nutrition module — meal logs & plate photos (metadata in MongoDB, files in S3)
# S3 layout: {AWS_S3_PREFIX}/nutrition/photos|generated/...
AWS_S3_PREFIX=gym

# Amazon S3 (required for deploy and recommended for local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=iapp
AWS_S3_PREFIX=gym
# Optional — only if you serve public assets from CloudFront; nutrition photos stay private via API
AWS_S3_PUBLIC_BASE_URL=https://dvunuoe8609h3.cloudfront.net

# Dev-only offline fallback — files go to OS temp, not ./data and not the host data dir
# NUTRITION_LOCAL_STORAGE=true
