NODE_ENV=development
PORT=4100
HOST=0.0.0.0
BIND_HOST=0.0.0.0
AI_SERVICE_TOKEN=replace-with-shared-internal-token

# GPT (server-side only — never exposed to the frontend).
# Leave GPT_API_KEY empty to disable the GPT path; rule-based Quick Generate still works.
GPT_API_KEY=
GPT_MODEL=gpt-4o-mini
GPT_BASE_URL=https://api.openai.com/v1
# Nutrition plate image generation (optional — falls back to GPT_API_KEY)
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-1
