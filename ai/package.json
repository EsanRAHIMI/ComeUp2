{
  "name": "comeup-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:domain": "npm run build --prefix ../shared/domain",
    "dev": "npm run build:domain && tsx watch src/server.ts",
    "build": "npm run build:domain && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@comeup/domain": "file:../shared/domain",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
